NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

DATABASE_URL=postgresql://user:password@localhost:5432/tickets_db

# Opcional: URL de la base usada por los tests (aislada de la de desarrollo).
# Si no se define, se deriva automáticamente de DATABASE_URL apuntando a una
# base llamada "tickets_test" en el mismo servidor. Ver backend/tests/setup/.
DATABASE_URL_TEST=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

PAYMENT_PROVIDER=mock
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

QR_SIGNING_SECRET=

# Email de la entrada General (ver backend/src/integrations/email/).
# EMAIL_PROVIDER vacío = integración deshabilitada (no se intenta nada).
# "console" = modo seguro de desarrollo: arma el email pero solo loguea un
#   resumen sin datos sensibles, no envía nada real. No requiere API key.
# "resend"  = envío real por HTTP a Resend. Requiere EMAIL_API_KEY y EMAIL_FROM.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

# Zona horaria para formatear fecha/horario del evento en el email (nunca la
# del servidor, implícita). Temporal, para el único evento demo actual —
# cuando existan eventos reales múltiples, esto debe guardarse por Event.
EVENT_TIMEZONE=America/Argentina/Buenos_Aires

ORDER_EXPIRATION_MINUTES=15

# MVP temporal: habilita POST /api/events/:eventPublicId/check-ins, que marca
# tickets como usados. Todavía no hay autenticación de validadores, así que
# esta ruta debe permanecer apagada salvo en desarrollo/staging controlado.
# Deshabilitado por defecto: solo el valor exacto "true" la activa.
ENABLE_MVP_CHECKIN=false

# MVP temporal: habilita POST /api/dev/orders/:orderPublicId/simulate-payment,
# que aprueba/rechaza/cancela pagos VIP de mentira (sin Mercado Pago real) y,
# si aprueba, emite tickets reales. Debe permanecer apagado salvo en
# desarrollo/tests — nunca en producción. Deshabilitado por defecto: solo el
# valor exacto "true" la activa. Ver backend/src/modules/payments/.
ENABLE_MVP_PAYMENT_SIMULATOR=false
