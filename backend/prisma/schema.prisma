generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  VALIDATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CANCELLED
  FINISHED
}

enum TicketTypeStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PAID
  REJECTED
  CANCELLED
  EXPIRED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

enum CheckInResult {
  VALID
  ALREADY_USED
  INVALID
  WRONG_EVENT
  NOT_PAID
  CANCELLED
}

model User {
  id          String     @id @default(cuid())
  firebaseUid String?    @unique
  email       String     @unique
  displayName String?
  phone       String?
  role        UserRole   @default(USER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  orders    Order[]
  checkIns  CheckIn[]
  auditLogs AuditLog[]
}

model Event {
  id                 String      @id @default(cuid())
  publicId           String      @unique @default(cuid())
  title              String
  slug               String      @unique
  description        String
  coverImageUrl      String?
  venueName          String
  address            String
  startsAt           DateTime
  endsAt             DateTime
  salesStartAt       DateTime
  salesEndAt         DateTime
  capacity           Int
  status             EventStatus @default(DRAFT)
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  ticketTypes TicketType[]
  orders      Order[]
  checkIns    CheckIn[]
}

model TicketType {
  id             String           @id @default(cuid())
  eventId        String
  name           String
  description    String?
  price          Decimal          @db.Decimal(10, 2)
  currency       String           @default("ARS")
  capacity       Int
  maxPerOrder    Int
  /// Cantidad de tickets individuales que se emiten por cada unidad comprada de este tipo (general y VIP individual = 1, VIP doble = 2). La emisión debe leer este valor, no inferirlo del nombre del tipo.
  ticketsPerUnit Int              @default(1)
  salesStartAt   DateTime
  salesEndAt     DateTime
  status         TicketTypeStatus @default(ACTIVE)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  event      Event       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  tickets    Ticket[]

  @@index([eventId])
}

model Order {
  id                 String      @id @default(cuid())
  publicId           String      @unique @default(cuid())
  userId             String
  eventId            String
  status             OrderStatus @default(PENDING)
  currency           String      @default("ARS")
  subtotal           Decimal     @db.Decimal(10, 2)
  total              Decimal     @db.Decimal(10, 2)
  paymentProvider    String?
  externalReference  String?
  expiresAt          DateTime?
  paidAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  refundedAt         DateTime?
  refundReason       String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  event         Event                 @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  payments      Payment[]
  tickets       Ticket[]
  webhookEvents PaymentWebhookEvent[]

  @@index([userId])
  @@index([eventId])
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  ticketTypeId  String
  quantity      Int
  unitPrice     Decimal @db.Decimal(10, 2)
  subtotal      Decimal @db.Decimal(10, 2)
  /// Nombres de los asistentes (array de strings), en el mismo orden en que se emiten los Ticket cuando el pago queda aprobado. Opcional: el registro General no lo usa (el propio holderName del ticket alcanza). Ver docs/DECISIONS.md.
  attendeeNames Json?

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  tickets    Ticket[]

  @@index([orderId])
  @@index([ticketTypeId])
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  provider           String
  providerPaymentId  String?
  status             PaymentStatus @default(PENDING)
  amount             Decimal       @db.Decimal(10, 2)
  currency           String        @default("ARS")
  paymentMethod      String?
  rawStatus          String?
  approvedAt         DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  refundedAt         DateTime?
  refundReason       String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order         Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents PaymentWebhookEvent[]

  @@unique([provider, providerPaymentId])
  @@index([orderId])
}

model Ticket {
  id                 String       @id @default(cuid())
  publicId           String       @unique @default(cuid())
  orderId            String
  orderItemId        String
  ticketTypeId       String
  holderName         String
  holderEmail        String
  qrTokenHash        String       @unique
  status             TicketStatus @default(ACTIVE)
  issuedAt           DateTime     @default(now())
  usedAt             DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  refundedAt         DateTime?
  refundReason       String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  order      Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  orderItem  OrderItem  @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  checkIns   CheckIn[]

  @@index([orderId])
  @@index([orderItemId])
  @@index([ticketTypeId])
}

model CheckIn {
  id              String        @id @default(cuid())
  ticketId        String
  eventId         String
  validatorUserId String
  result          CheckInResult
  checkedAt       DateTime      @default(now())
  deviceInfo      String?
  ipAddress       String?

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Restrict)
  validator User   @relation(fields: [validatorUserId], references: [id], onDelete: Restrict)

  @@index([ticketId])
  @@index([eventId])
  @@index([validatorUserId])
}

model PaymentWebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime?
  paymentId       String?
  orderId         String?
  createdAt       DateTime  @default(now())

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@unique([provider, externalEventId])
  @@index([paymentId])
  @@index([orderId])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
}
